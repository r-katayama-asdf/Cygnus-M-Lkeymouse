#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define SYM_FN 1
#define SYMNUM 2
#define NUMPAD 3
#define MOUSE  4
#define SCROLL 5
#define BT     6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        // Assign to L in ZMK Studio. Requires position 40 to send a real LCTRL
        // (Karabiner's global caps<->ctrl swap must not apply to this keyboard),
        // otherwise the firmware never sees a modifier and this never morphs.
        lt_l: lt_l_ctrl_aware {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "LT-L (Ctrl aware)";
            bindings  = <&lt MOUSE L>, <&kp L>;
            mods      = <(MOD_LCTL|MOD_RCTL)>;
            keep-mods = <(MOD_LCTL|MOD_RCTL)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // MacBook-like base. S/L are Lkeymouse layer-tap (hold = MOUSE; J=click).
            // A and SEMI are plain (SCROLL layer-tap removed). Del position = NUMPAD hold.
            // Left thumb: 44=SYM_FN hold, 45=Space/SYMNUM hold, 46=Cmd.
            // 40=Ctrl, 41=Caps: lt_l needs the firmware to see a real LCTRL, so
            // Karabiner must not swap caps/ctrl for this keyboard. Don't flip these back.
            bindings = <
&lt BT ESC  &kp Q       &kp W       &kp E       &kp R       &kp T                                                     &kp Y        &kp U  &kp I      &kp O        &kp P         &kp BSPC
&kp TAB     &kp A       &lt MOUSE S &kp D       &kp F       &kp G              &mkp MCLK          &kp ESC             &kp H        &kp J  &kp K      &lt MOUSE L  &kp SEMI      &kp SQT
&kp LSHFT   &kp Z       &kp X       &kp C       &kp V       &kp B              &mo NUMPAD         &kp LS(LC(LA(LGUI))) &kp N        &kp M  &kp COMMA  &kp DOT      &kp FSLH      &kp RSHFT
&kp LCTRL   &kp CAPS    &kp LALT    &kp LGUI    &mo SYM_FN  &lt SYMNUM SPACE   &kp LGUI           &kp BSPC            &kp ENTER                                  &kp LG(LBKT)  &kp LG(RBKT)
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        sym_fn_layer {
            // Top row: F1-F12. Right hand: programming symbols. Left hand: trans.
            bindings = <
&kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6                                              &kp F7       &kp F8     &kp F9      &kp F10     &kp F11     &kp F12
&trans      &trans      &trans      &trans      &trans      &trans       &trans             &kp UNDER           &kp LPAR     &kp RPAR   &kp LBRC    &kp RBRC    &kp LBKT    &kp RBKT
&trans      &trans      &trans      &trans      &trans      &trans       &trans             &trans              &kp LT       &kp GT     &kp MINUS   &kp EQUAL   &kp PLUS    &trans
&trans      &trans      &trans      &trans      &trans      &trans       &trans             &kp ENTER           &trans                                          &kp BSLH    &kp PIPE
            >;

            sensor-bindings = <&ROTATE C_VOL_DN C_VOL_UP>;
        };

        symnum_layer {
            // !@#$%^&* — the shifted-number-row symbols as a 2x4 block on the right hand.
            // H J K L = ! @ # $   /   N M , . = % ^ & *   (stacked: !@#$ on home, %^&* directly below).
            // Activated by holding left thumb middle (Space key).
            bindings = <
&trans      &trans      &trans      &trans      &trans      &trans                                              &trans       &trans     &trans      &trans      &trans      &trans
&trans      &trans      &trans      &trans      &trans      &trans       &trans             &trans              &kp EXCL     &kp AT     &kp HASH    &kp DLLR    &trans      &trans
&trans      &trans      &trans      &trans      &trans      &trans       &trans             &trans              &kp PRCNT    &kp CARET  &kp AMPS    &kp STAR    &trans      &trans
&trans      &trans      &trans      &trans      &trans      &trans       &trans             &trans              &trans                                          &trans      &trans
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        numpad_layer {
            // Right hand calculator numpad (N* avoids NumLock-arrow issue).
            // Activated by holding the Del-position key (left row-3 inner).
            bindings = <
&trans      &trans      &trans      &trans      &trans      &trans                                              &trans       &kp N7     &kp N8      &kp N9      &kp MINUS   &kp BSPC
&trans      &trans      &trans      &trans      &trans      &trans       &trans             &trans              &trans       &kp N4     &kp N5      &kp N6      &kp PLUS    &kp EQUAL
&trans      &trans      &trans      &trans      &trans      &trans       &trans             &trans              &trans       &kp N1     &kp N2      &kp N3      &kp STAR    &trans
&trans      &trans      &trans      &trans      &trans      &trans       &trans             &kp N0              &trans                                          &kp DOT     &kp COMMA
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        mouse_layer {
            // Activated by holding S or L (Lkeymouse default). J = MB1 (left click).
            bindings = <
&trans  &trans       &trans  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(R)                      &kp LC(R)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans  &trans       &trans
&trans  &lt 5 SPACE  &trans  &mkp MB1         &mkp MB2           &mkp MB3   &mkp MB3    &trans  &mkp MB3   &mkp MB1         &mkp MB2           &trans  &lt 5 SPACE  &trans
&trans  &trans       &trans  &trans           &trans             &trans     &trans      &trans  &trans     &mkp MB4         &mkp MB5           &trans  &trans       &trans
&trans  &trans       &trans  &trans           &trans             &trans     &trans      &trans  &trans                                                 &trans       &trans
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        scroll_layer {
            // All transparent; reachable from the MOUSE layer.
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans  &trans
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        bt_layer {
            // Activated by Esc (top-left) hold. BT_SEL on right top row.
            bindings = <
&trans  &trans  &trans        &trans        &trans        &trans                       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans        &trans        &trans        &trans     &trans    &trans  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans    &trans  &trans        &trans        &trans        &trans        &bt BT_CLR      &trans
&trans  &trans  &trans        &trans        &trans        &trans     &trans    &trans  &trans                                                  &bt BT_CLR_ALL  &trans
            >;
        };
    };
};
